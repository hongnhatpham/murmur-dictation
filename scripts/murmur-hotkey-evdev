#!/usr/bin/env python3
"""Tiny evdev hold-to-record hotkey daemon for Murmur.

Listens for Super+M across real keyboard devices. Press starts recording;
releasing either M or Super stops and processes. Intended to be run with
root input access while commands execute as the original desktop user.
"""
from __future__ import annotations

import os
import selectors
import shutil
import subprocess
import time
from pathlib import Path

from evdev import InputDevice, ecodes, list_devices

MURMUR = "/mnt/storage/01 Projects/murmur-dictation/.venv/bin/murmur"
KEY_SUPERS = {ecodes.KEY_LEFTMETA, ecodes.KEY_RIGHTMETA}
KEY_TRIGGER = ecodes.KEY_M
RESCAN_INTERVAL_SECONDS = 2.0


def desktop_user() -> tuple[str, int]:
    user = os.environ.get("MURMUR_DESKTOP_USER") or os.environ.get("SUDO_USER") or os.environ.get("PKEXEC_UID") or os.environ.get("USER") or "hongnhatpham"
    if user == "root":
        user = "hongnhatpham"
    if user.isdigit():
        import pwd
        pw = pwd.getpwuid(int(user))
        return pw.pw_name, pw.pw_uid
    import pwd
    pw = pwd.getpwnam(user)
    return pw.pw_name, pw.pw_uid


def desktop_home() -> Path:
    import pwd
    user, _uid = desktop_user()
    return Path(pwd.getpwnam(user).pw_dir)


def log_path() -> Path:
    return desktop_home() / ".local/state/murmur/hotkey-evdev.log"


def log(message: str) -> None:
    try:
        path = log_path()
        path.parent.mkdir(parents=True, exist_ok=True)
        with path.open("a", encoding="utf-8") as fh:
            fh.write(f"{time.strftime('%Y-%m-%dT%H:%M:%S%z')} {message}\n")
    except Exception:
        pass


def command_env(uid: int) -> list[str]:
    keep = {}
    for key in ("WAYLAND_DISPLAY", "DISPLAY", "DBUS_SESSION_BUS_ADDRESS", "XAUTHORITY"):
        value = os.environ.get(key)
        if value:
            keep[key] = value
    keep.setdefault("XDG_RUNTIME_DIR", f"/run/user/{uid}")
    keep.setdefault("WAYLAND_DISPLAY", "wayland-1")
    # Keep hotkey-driven dictation focus-stable while we debug insertion.
    keep.setdefault("MURMUR_NOTIFY", "0")
    return [f"{key}={value}" for key, value in keep.items()]


def as_user_command(args: list[str]) -> list[str]:
    user, uid = desktop_user()
    if os.geteuid() == uid:
        return args
    return ["runuser", "-u", user, "--", "env", *command_env(uid), *args]


def run_logged(args: list[str], *, wait: bool, timeout: float = 10) -> None:
    log("run " + " ".join(args))
    out_path = log_path()
    out_path.parent.mkdir(parents=True, exist_ok=True)
    stdout = out_path.open("a", encoding="utf-8")
    stderr = subprocess.STDOUT
    try:
        if wait:
            rc = subprocess.run(args, stdout=stdout, stderr=stderr, timeout=timeout).returncode
            log(f"rc={rc}")
        else:
            subprocess.Popen(args, stdout=stdout, stderr=stderr, start_new_session=True)
            log("spawned")
    except Exception as exc:
        log(f"command failed: {exc!r}")
    finally:
        stdout.close()


def run_murmur(args: list[str], *, wait: bool) -> None:
    run_logged(as_user_command([MURMUR, *args]), wait=wait)


def erase_trigger_leak() -> None:
    """Remove the physical 'm' that leaks through because evdev observes but doesn't consume keys."""
    if os.environ.get("MURMUR_ERASE_TRIGGER_LEAK", "1").lower() in {"0", "false", "no", "off"}:
        return
    if shutil.which("wtype") is None:
        log("skip trigger leak erase: wtype missing")
        return
    log("erase trigger leak with BackSpace")
    run_logged(as_user_command(["wtype", "-k", "BackSpace"]), wait=True, timeout=2)


def keyboard_devices(*, log_devices: bool = True) -> list[InputDevice]:
    devices: list[InputDevice] = []
    for path in list_devices():
        try:
            dev = InputDevice(path)
            keys = set(dev.capabilities().get(ecodes.EV_KEY, []))
            roles = []
            if KEY_TRIGGER in keys:
                roles.append("trigger")
            if keys.intersection(KEY_SUPERS):
                roles.append("modifier")
            # Composite keyboards often split regular keys and modifiers across
            # multiple evdev nodes. Watch every node that contributes any part
            # of the hotkey, then track pressed state globally across devices.
            if roles:
                devices.append(dev)
                if log_devices:
                    log(f"device {dev.path} {dev.name} roles={','.join(roles)}")
            else:
                dev.close()
        except PermissionError as exc:
            log(f"permission denied {path}: {exc}")
        except Exception as exc:
            log(f"skip {path}: {exc!r}")
    return devices


def main() -> int:
    log_path().parent.mkdir(parents=True, exist_ok=True)
    log("starting")
    sel = selectors.DefaultSelector()
    devices: list[InputDevice] = []

    def close_devices() -> None:
        for dev in devices:
            try:
                sel.unregister(dev.fd)
            except Exception:
                pass
            try:
                dev.close()
            except Exception:
                pass
        devices.clear()

    def rescan_devices() -> bool:
        previous_paths = {dev.path for dev in devices}
        close_devices()
        devices.extend(keyboard_devices(log_devices=not previous_paths))
        current_paths = {dev.path for dev in devices}
        for dev in devices:
            sel.register(dev.fd, selectors.EVENT_READ, dev)
        if devices:
            if current_paths != previous_paths:
                if previous_paths:
                    log(
                        "keyboard device set changed "
                        f"old={','.join(sorted(previous_paths))} "
                        f"new={','.join(sorted(current_paths))}"
                    )
                log(f"watching {len(devices)} keyboard device(s)")
            return True
        log("no keyboard devices found; waiting for input devices/root access")
        return False

    rescan_devices()

    pressed_supers: set[tuple[str, int]] = set()
    pressed_triggers: set[tuple[str, int]] = set()
    recording = False

    def start() -> None:
        nonlocal recording
        if recording:
            return
        recording = True
        log("hotkey start")
        run_murmur(["start-recording", "--paste"], wait=True)

    def stop(reason: str) -> None:
        nonlocal recording
        if not recording:
            return
        recording = False
        log(f"hotkey stop reason={reason}")
        # Wait a beat so the compositor/app has seen the physical modifier releases.
        time.sleep(0.12)
        erase_trigger_leak()
        time.sleep(0.05)
        run_murmur(["stop-recording"], wait=False)

    def maybe_start() -> None:
        if pressed_supers and pressed_triggers:
            start()

    def maybe_stop(reason: str) -> None:
        if recording and not pressed_supers and not pressed_triggers:
            stop(reason)

    try:
        while True:
            if not devices:
                rescan_devices()
                if not devices:
                    time.sleep(RESCAN_INTERVAL_SECONDS)
                    continue

            selected = sel.select(timeout=RESCAN_INTERVAL_SECONDS)
            if not selected:
                if not recording and not pressed_supers and not pressed_triggers:
                    rescan_devices()
                continue

            for key, _mask in selected:
                dev: InputDevice = key.data
                try:
                    events = dev.read()
                except OSError as exc:
                    if getattr(exc, "errno", None) == 19:  # ENODEV: keyboard unplugged or re-enumerated.
                        log(f"device disappeared {getattr(dev, 'path', '?')}; rescanning")
                        try:
                            sel.unregister(dev.fd)
                        except Exception:
                            pass
                        try:
                            dev.close()
                        except Exception:
                            pass
                        devices = [candidate for candidate in devices if candidate is not dev]
                        pressed_supers.difference_update({key for key in pressed_supers if key[0] == dev.path})
                        pressed_triggers.difference_update({key for key in pressed_triggers if key[0] == dev.path})
                        continue
                    raise
                for event in events:
                    if event.type != ecodes.EV_KEY:
                        continue
                    code = event.code
                    value = event.value  # 1 down, 0 up, 2 repeat
                    if value == 2:
                        continue
                    key_id = (dev.path, code)
                    if code in KEY_SUPERS:
                        if value == 1:
                            pressed_supers.add(key_id)
                            maybe_start()
                        elif value == 0:
                            pressed_supers.discard(key_id)
                            maybe_stop("all-keys-released")
                    elif code == KEY_TRIGGER:
                        if value == 1:
                            pressed_triggers.add(key_id)
                            maybe_start()
                        elif value == 0:
                            pressed_triggers.discard(key_id)
                            maybe_stop("all-keys-released")
    except KeyboardInterrupt:
        log("keyboard interrupt")
        if recording:
            run_murmur(["cancel-recording"], wait=True)
        return 130


if __name__ == "__main__":
    raise SystemExit(main())
