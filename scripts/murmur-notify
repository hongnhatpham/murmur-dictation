#!/usr/bin/env bash
set -euo pipefail

state="${1:-info}"
shift || true
message="${*:-}"

case "$state" in
  recording) summary="Murmur: recording"; urgency="normal"; timeout=1200 ;;
  processing) summary="Murmur: processing"; urgency="low"; timeout=1200 ;;
  inserted) summary="Murmur: inserted"; urgency="low"; timeout=900 ;;
  copied|fallback) summary="Murmur: copied"; urgency="normal"; timeout=1600 ;;
  canceled) summary="Murmur: canceled"; urgency="low"; timeout=900 ;;
  failed|error) summary="Murmur: failed"; urgency="normal"; timeout=3500 ;;
  *) summary="Murmur"; urgency="low"; timeout=1500 ;;
esac

if command -v notify-send >/dev/null 2>&1; then
  notify-send --app-name="Murmur" --urgency="$urgency" --expire-time="$timeout" "$summary" "$message"
else
  printf '%s %s\n' "$summary" "$message" >&2
fi
