#!/usr/bin/env python3
from __future__ import annotations

import json
import math
import os
import struct
import sys
import time
from pathlib import Path

STATE = Path.home() / ".local/state/murmur/meter.json"
AUDIO = Path(sys.argv[1]).expanduser() if len(sys.argv) > 1 else None


def write(active: bool, level: float = 0.0) -> None:
    STATE.parent.mkdir(parents=True, exist_ok=True)
    tmp = STATE.with_suffix(".json.tmp")
    tmp.write_text(json.dumps({"active": active, "level": max(0.0, min(1.0, level)), "updated_at": time.time()}), encoding="utf-8")
    tmp.replace(STATE)


def wav_level(path: Path) -> float:
    try:
        data = path.read_bytes()
    except OSError:
        return 0.0
    if len(data) <= 44:
        return 0.0
    pcm = data[-min(len(data) - 44, 16000):]
    if len(pcm) < 2:
        return 0.0
    if len(pcm) % 2:
        pcm = pcm[:-1]
    count = len(pcm) // 2
    samples = struct.unpack("<" + "h" * count, pcm)
    if not samples:
        return 0.0
    rms = math.sqrt(sum(s * s for s in samples) / len(samples)) / 32768.0
    # Gate room noise, then use a moderate curve. This keeps silence calm while
    # still making speech react quickly.
    noise_floor = 0.018
    ceiling = 0.16
    normalized = max(0.0, (rms - noise_floor) / (ceiling - noise_floor))
    return min(1.0, normalized ** 0.72)


def main() -> int:
    if AUDIO is None:
        write(False, 0.0)
        return 0
    write(True, 0.05)
    try:
        while True:
            write(True, wav_level(AUDIO))
            time.sleep(0.035)
    except KeyboardInterrupt:
        write(False, 0.0)
        return 0


if __name__ == "__main__":
    raise SystemExit(main())
