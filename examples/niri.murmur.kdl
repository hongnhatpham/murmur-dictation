// Example Murmur bindings for niri. Copy the relevant lines into ~/.config/niri/config.kdl.
// niri bindings are press-triggered; for the first MVP use a one-shot command
// rather than true press/release hold-to-talk.

binds {
    // One-shot dictation: the command owns recording duration, transcription,
    // clipboard copy/paste, and notifications.
    Mod+Space repeat=false { spawn "sh" "-lc" "murmur dictate --paste"; }

    // Optional: recover the last successful dictation to the clipboard.
    Mod+Shift+Space repeat=false { spawn "sh" "-lc" "murmur recopy-last && notify-send --app-name=Murmur 'Murmur: copied last'"; }

    // Optional command pair for a release-aware binding helper.
    // Mod+Alt+Space repeat=false { spawn "sh" "-lc" "murmur start-recording --paste"; }
    // Mod+Alt+V repeat=false { spawn "sh" "-lc" "murmur stop-recording"; }
    // Mod+Alt+Escape repeat=false { spawn "sh" "-lc" "murmur cancel-recording"; }
}
