[Unit]
Description=Murmur dictation user service
Documentation=https://github.com/hongnhatpham/murmur-dictation
After=graphical-session.target pipewire.service wireplumber.service
Wants=pipewire.service wireplumber.service

[Service]
Type=simple
WorkingDirectory=@PROJECT_DIR@
EnvironmentFile=-%h/.config/murmur/env
# Keep the command narrow and override-friendly while the CLI is still a prototype.
# Expected long-running CLI shape: `murmur service` or `murmur daemon`.
ExecStart=@MURMUR_BIN@ service
Restart=on-failure
RestartSec=2s

# User-service hardening that should not break audio, Wayland, or notifications.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/murmur %h/.local/share/murmur %h/.cache/murmur %h/.config/murmur

[Install]
WantedBy=default.target
